                equipment: '초대형 창고용 조기반응 스프링클러 및 화재 제연설비',
                area: '120,000 ㎡',
                btype: '창고시설 (물류센터)',
                year: '2024',
                location: '충청남도 천안시'
            }
        };

        function openModal(projectId) {
            const data = projectData[projectId];
            if (!data) return;

            document.getElementById('modal-title').innerText = data.title;
            document.getElementById('modal-client').innerText = data.client;
            document.getElementById('modal-architect').innerText = data.architect;
            document.getElementById('modal-content-type').innerText = data.content;
            document.getElementById('modal-equipment').innerText = data.equipment;
            document.getElementById('modal-area').innerText = data.area;
            document.getElementById('modal-btype').innerText = data.btype;
            document.getElementById('modal-year').innerText = data.year;
            document.getElementById('modal-location').innerText = data.location;

            const modal = document.getElementById('project-modal');
            const content = document.getElementById('modal-content');
            
            modal.classList.remove('hidden');
            document.body.classList.add('modal-open'); 
            
            void modal.offsetWidth; 
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
        }

        function closeModal() {
            const modal = document.getElementById('project-modal');
            const content = document.getElementById('modal-content');
            
            modal.classList.add('opacity-0');
            content.classList.add('scale-95');
            document.body.classList.remove('modal-open');
            
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300); 
        }

        document.getElementById('project-modal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash.replace('#', '');
            if (hash && document.getElementById(hash)) {
                switchPage(hash);
            } else {
                switchPage('page-home');
            }
            initProjectFilters();
        });
    </script>
</body>
</html>
