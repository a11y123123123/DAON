    <script>
        // --- 1. SPA Routing Logic ---
        function switchPage(pageId) {
            // Hide all pages
            const pages = document.querySelectorAll('.page-container');
            pages.forEach(page => {
                page.classList.remove('active-page');
            });
            
            // Show target page
            const targetPage = document.getElementById(pageId);
            if(targetPage) {
                targetPage.classList.add('active-page');
                window.scrollTo({ top: 0, behavior: 'instant' });
            }

            // Update Nav visual states
            const navLinks = document.querySelectorAll('.nav-link');
            navLinks.forEach(link => {
                if(link.getAttribute('href') === '#' + pageId) {
                    link.classList.add('active-nav');
                    link.classList.add('text-accent');
                    link.classList.remove('text-white', 'text-gray-600');
                } else {
                    link.classList.remove('active-nav', 'text-accent');
                }
            });

            // Re-trigger scroll observer for new page elements
            initializeReveal();
            evaluateNavbarStyle(pageId);
            
            // Update URL hash without jumping
            if(history.pushState) {
                history.pushState(null, null, '#' + pageId);
            }
        }

        window.addEventListener('hashchange', () => {
            const hash = window.location.hash.replace('#', '') || 'page-home';
            if (document.getElementById(hash)) {
                switchPage(hash);
            }
        });

        // --- 2. Navbar Styling ---
        const navbar = document.getElementById('navbar');
        const logoText = document.getElementById('logo-text');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        
        function evaluateNavbarStyle(currentPageId) {
            const navLinks = document.querySelectorAll('.nav-link');
            
            if (currentPageId === 'page-home') {
                if (window.scrollY > 50) {
                    setNavDark(navLinks);
                } else {
                    setNavLight(navLinks);
                }
            } else {
                setNavDark(navLinks);
            }
        }

        function setNavDark(navLinks) {
            navbar.classList.add('bg-white', 'shadow-sm', 'py-3');
            navbar.classList.remove('py-2', 'bg-transparent');
            logoText.classList.replace('text-white', 'text-primary');
            mobileMenuBtn.classList.replace('text-white', 'text-primary');
            
            navLinks.forEach(link => {
                if(!link.classList.contains('active-nav')) {
                    link.classList.add('text-gray-600');
                    link.classList.remove('text-white');
                }
            });
        }

        function setNavLight(navLinks) {
            navbar.classList.add('bg-transparent', 'py-2');
            navbar.classList.remove('bg-white', 'shadow-sm', 'py-3');
            logoText.classList.replace('text-primary', 'text-white');
            mobileMenuBtn.classList.replace('text-primary', 'text-white');
            
            navLinks.forEach(link => {
                if(!link.classList.contains('active-nav')) {
                    link.classList.add('text-white');
                    link.classList.remove('text-gray-600');
                }
            });
        }

        window.addEventListener('scroll', () => {
            const activePage = document.querySelector('.page-container.active-page');
            const pageId = activePage ? activePage.id : 'page-home';
            evaluateNavbarStyle(pageId);
        });

        // --- 3. Scroll Reveal Animation ---
        let revealOnScroll;
        function initializeReveal() {
            if (revealOnScroll) revealOnScroll.disconnect();
            
            const reveals = document.querySelectorAll('.page-container.active-page .reveal');
            const revealOptions = {
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px"
            };

            revealOnScroll = new IntersectionObserver(function(entries, observer) {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target); 
                });
            }, revealOptions);

            reveals.forEach(reveal => {
                reveal.classList.remove('active');
                revealOnScroll.observe(reveal);
            });
        }

        // --- 4. Project Filtering Logic ---
        function initProjectFilters() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const projectItems = document.querySelectorAll('.project-item');
            const yearBlocks = document.querySelectorAll('.year-block');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => {
                        b.classList.remove('active', 'bg-primary', 'text-white');
                        b.classList.add('bg-white', 'text-gray-600');
                    });
                    
                    btn.classList.remove('bg-white', 'text-gray-600');
                    btn.classList.add('active', 'bg-primary', 'text-white');

                    const filter = btn.getAttribute('data-filter');

                    projectItems.forEach(item => {
                        const categoryString = item.getAttribute('data-category');
                        const categories = categoryString ? categoryString.split(',') : [];
                        
                        if (filter === 'all' || categories.includes(filter)) {
                            item.style.display = 'flex'; 
                        } else {
                            item.style.display = 'none';
                        }
                    });

                    yearBlocks.forEach(block => {
                        const visibleItems = Array.from(block.querySelectorAll('.project-item')).filter(item => item.style.display !== 'none');
                        if (visibleItems.length === 0) {
                            block.style.display = 'none';
                        } else {
                            block.style.display = 'block';
                        }
                    });
                });
            });
        }

